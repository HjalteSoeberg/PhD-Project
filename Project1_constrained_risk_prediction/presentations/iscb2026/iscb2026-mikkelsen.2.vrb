\frametitle{Predicting the absolute 6-year risk of diabetes in presence of the competing risk of death}
\begin{align*}
F_1(6\mid x)&=P(\text{diabetes by 6 years}\mid x),\\
F_2(6\mid x)&=P(\text{death without diabetes by 6 years}\mid x).
\end{align*}

